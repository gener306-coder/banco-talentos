# Valores de desarrollo. Producción y piloto (T-S17-04, auditoría QA sección 3 #1): los valores reales viven en AWS SSM
# Parameter Store (/banco-talentos/pilot/*) y el servidor los escribe al arrancar; nunca se versionan. Los comentarios
# «Piloto:» indican el valor esperado allí.
APP_NAME="Banco de Talentos"
# Piloto: APP_ENV=production y APP_DEBUG=false. APP_KEY cifra el NSS y la póliza: se genera una vez
# (php artisan key:generate --show), se guarda como SecureString y se respalda fuera de AWS; perderla los hace ilegibles.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Piloto: https://<dominio> en ambas (la SPA y la API se sirven en el mismo sitio).
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
# CORS (auditoría QA #11): orígenes exactos separados por comas. Vacío usa FRONTEND_URL. En producción: https://<dominio>.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Ruta de la SPA que recibe el enlace de restablecimiento de contraseña.
FRONTEND_PASSWORD_RESET_PATH=/reset-password

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

# Piloto: LOG_LEVEL=warning (stderr lo recoge journald).
LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=banco_talentos
DB_USERNAME=banco_talentos
DB_PASSWORD=local_password
# Piloto: DB_HOST con el endpoint de RDS, DB_PASSWORD aleatoria de 32 caracteres (SecureString) y DB_SSLMODE=require.
DB_SSLMODE=prefer

CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Piloto: SESSION_SECURE_COOKIE=true (el Aviso de Privacidad lo afirma) y SESSION_DOMAIN vacío (cookie host-only).
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Piloto: SANCTUM_STATEFUL_DOMAINS=<dominio>.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:8000,127.0.0.1:8000
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
# Disco de videos promocionales: media (local) o s3. Las credenciales de S3 nunca se versionan.
MEDIA_DISK=media
# T-S17-02: disco privado de los comprobantes del seguro: local (storage/app/private) o s3.
PRIVATE_DOCUMENTS_DISK=local
# Piloto: MEDIA_DISK=s3, PRIVATE_DOCUMENTS_DISK=s3, AWS_DEFAULT_REGION=us-east-2 y AWS_BUCKET con el bucket privado.
# Sin AWS_ACCESS_KEY_ID ni AWS_SECRET_ACCESS_KEY: en la EC2, el SDK usa el rol IAM de la instancia.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
# Piloto (Resend): MAIL_SCHEME=smtps, MAIL_HOST=smtp.resend.com, MAIL_PORT=465, MAIL_USERNAME=resend,
# MAIL_PASSWORD=<API key> (SecureString) y MAIL_FROM_ADDRESS=no-reply@<dominio>. Cambiar a SES solo cambia estos valores.
MAIL_MAILER=smtp
MAIL_SCHEME=
# T-S18-05: logo de los correos. Vacío usa <FRONTEND_URL>/brand/logo-correo.png (en el piloto, el mismo dominio).
MAIL_LOGO_URL=
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_TIMEOUT=10
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@banco-talentos.test
